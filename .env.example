# -----------------------------------------------------------------------------
# Copy to ".env" and fill in real values.  NEVER commit the real .env file.
# Generate a secret key with:  python -c "import secrets;print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------

# Flask
SECRET_KEY=
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_SECONDS=28800

# How many reverse proxies stand in front of the app. Leave it at 0 when
# nothing does. Behind a proxy that terminates TLS the connection to the app
# is plain HTTP and the real scheme arrives in X-Forwarded-Proto: set this to
# the number of proxies and the app reads that header instead.
#
# Count them rather than guessing. The header is a list anything upstream may
# add to, so trusting one hop with two in front reads a value the client sent
# itself - and trusting a hop that is not there lets any caller that can
# reach the app claim to be somewhere else, on HTTPS.
TRUSTED_PROXY_HOPS=0
MAX_UPLOAD_BYTES=10485760

# Portal login (single shared operator account)
APP_USERNAME=
APP_PASSWORD=

# OpsRamp
OPSRAMP_BASE_URL=https://your-instance.api.opsramp.com
OPSRAMP_PARTNER_TENANT_ID=
OPSRAMP_OAUTH_CLIENT_ID=
OPSRAMP_OAUTH_CLIENT_SECRET=
OPSRAMP_VERIFY_TLS=true

# Endpoint overrides - only change these if your instance differs.
# OPSRAMP_TOKEN_PATH=/auth/oauth/token
# Listing clients lives on /clients/search. A bare /clients is the CREATE
# endpoint and answers GET with HTTP 405. If the first path is rejected with
# 404/405 the fallbacks below are tried in order.
# OPSRAMP_CLIENTS_PATH=/api/v2/tenants/{partner_id}/clients/search
# OPSRAMP_CLIENTS_FALLBACK_PATHS=/api/v2/tenants/{partner_id}/clients/minimal,/api/v2/tenants/{partner_id}/clients
# OPSRAMP_RESOURCE_SEARCH_PATH=/api/v2/tenants/{tenant_id}/resources/search
# OPSRAMP_RESOURCE_DETAIL_PATH=/api/v2/tenants/{tenant_id}/resources/{resource_id}
# Sub-resource endpoints merged into each resource payload. Firmware lives in
# these, not on the resource document, so emptying this list will make almost
# everything report VERSION NOT DETECTED. Each entry costs one API call per
# asset - trim it if a tenant is very large.
# OPSRAMP_RESOURCE_EXTRA_PATHS=/api/v2/tenants/{tenant_id}/resources/{resource_id}/appAttributes,/api/v2/tenants/{tenant_id}/resources/{resource_id}/customAttributes,/api/v2/tenants/{tenant_id}/resources/{resource_id}/nativeAttributes,/api/v2/tenants/{tenant_id}/resources/{resource_id}/components,/api/v2/tenants/{tenant_id}/resources/{resource_id}/tags,/api/v2/tenants/{tenant_id}/resources/{resource_id}/assets

# Only show tenants whose name matches this (case-insensitive substring/regex).
# Leave blank to list every client.
TENANT_NAME_FILTER=SAP

# HTTP behaviour
HTTP_TIMEOUT_CONNECT=10
HTTP_TIMEOUT_READ=60
HTTP_RETRY_TOTAL=4
HTTP_RETRY_BACKOFF=1.5
HTTP_POOL_SIZE=32
# Some OpsRamp endpoints reject large pages with HTTP 400. 100 is the
# documented default and is accepted everywhere.
OPSRAMP_PAGE_SIZE=100
OPSRAMP_MAX_PAGES=200

# Concurrency - keep well under the OpsRamp API rate limit.
MAX_WORKERS=12
DETAIL_FETCH_ENABLED=true
# Deep-fetch assets whose platform could not be identified from the search
# summary alone.  Safer, but costs more API calls on large tenants.
DEEP_FETCH_UNMATCHED=true
MAX_UNRESOLVED_DEEP_FETCH=2000

# Version comparison policy: "at_least" (newer than target is compliant)
# or "exact" (only an exact match is compliant).
VERSION_COMPARE_POLICY=at_least

# Storage
UPLOAD_DIR=var/uploads
JOB_RETENTION_SECONDS=21600
# One-off comparisons kept in memory. The matrix keeps its own runs whatever
# this is set to, so a cell never becomes a dead link because the cap was low.
MAX_JOBS=1000
# Where the matrix is cached between refreshes, so signing in renders the
# last known state immediately instead of waiting on a sweep. No credentials
# are kept here; deleting it costs nothing but the next refresh.
CACHE_DB_PATH=var/cache.db

LOG_LEVEL=INFO

# --- Compliance overview (the matrix on the home page) -----------------------
# Recipes are added on the page itself and kept in the library, so nothing
# here needs editing to change one. This path only seeds a fresh deployment:
# it is used when the library is empty, and an upload takes over from it.
DEFAULT_RECIPE_PATH=C:\OpsRamp_Automation\recipes\recipe.xlsx

# Where the model-equivalence declarations live. Unset, the model_aliases.csv
# shipped with the source is used. The declarations name the accounts they
# apply to, so a site that would rather keep its account names out of source
# control can point this at a copy held beside this file instead.
MODEL_ALIASES_PATH=

# Categories the sweep covers; "all" means every category.
OVERVIEW_CATEGORIES=all
# Minutes between automatic refreshes. 0 leaves it to the Refresh button.
#
# A sweep reads every asset of every account, so on a large estate it can
# take longer than this interval. A tick that arrives while a sweep is still
# running is dropped, so sweeps run back to back rather than piling up - but
# the load on OpsRamp is then continuous. Raise this (720 is twice a day) if
# that matters more than how fresh the grid is.
OVERVIEW_REFRESH_MINUTES=10
# Refresh once shortly after start-up. The cache means the page is not empty
# in the meantime - it shows the state from before the restart.
OVERVIEW_REFRESH_ON_START=true
# Cap how many tenants a sweep covers. 0 means no limit.
OVERVIEW_MAX_TENANTS=0
# How many accounts the sweep reads at once. Reading is mostly waiting on
# OpsRamp, so this is where the time goes on a large estate. Each account
# already fans out over its own assets, so requests in flight are roughly
# this times MAX_WORKERS - raise it if OpsRamp keeps up, set it to 1 for
# the old one-account-at-a-time behaviour.
OVERVIEW_TENANT_WORKERS=4
